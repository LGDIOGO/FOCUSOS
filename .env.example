# Google Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Gemini AI
GOOGLE_AI_API_KEY=

# Google Calendar OAuth (console.cloud.google.com → APIs & Serviços → Credenciais → OAuth 2.0)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# URL must match exactly what's registered in Google Cloud Console
GOOGLE_CALENDAR_REDIRECT_URI=https://yourdomain.com/api/integrations/google-calendar/callback