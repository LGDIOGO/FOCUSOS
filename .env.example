# Copie para .env.local e preencha. NUNCA commite o .env.local (já está no .gitignore).
# Todas as variáveis abaixo são lidas pelo código; a lista foi gerada varrendo process.env.*

# ── Firebase (cliente) ─ Console do Firebase → Configurações do projeto → Seus apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (servidor) ─ Console → Configurações → Contas de serviço → Gerar nova chave
# Sem estas duas, TODA rota que grava via Admin SDK falha em produção
# (incluindo a conexão com o Google Calendar). Dão acesso total ao banco: trate como senha.
# Use client_email e private_key do JSON baixado. A chave vai numa linha, com \n literais.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Refresh token para o auto-deploy de regras via /api/admin/fix-rules (opcional)
FIREBASE_OAUTH_REFRESH_TOKEN=

# ── IA ─ o chat, insights, leitura de lançamentos e plano financeiro usam estes
# Groq é o primário; Gemini é o fallback (lib/ai/models.ts).
GROQ_API_KEY=
GOOGLE_AI_API_KEY=

# ── Google Calendar (OAuth) ─ console.cloud.google.com → APIs e serviços → Credenciais
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Precisa ser IDÊNTICA à URI cadastrada no Console do Google. Local e produção são diferentes.
# Local:    http://localhost:3000/api/integrations/google-calendar/callback
# Produção: https://focusos-rlvs.vercel.app/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=

# ── Pagamentos (Mercado Pago) ─ opcional
MP_ACCESS_TOKEN=
WEBHOOK_URL=

# ── App
NEXT_PUBLIC_APP_URL=http://localhost:3000
