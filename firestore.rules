rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwnerByField() {
      return isAuth() && request.auth.uid == resource.data.user_id;
    }

    // Só para `update` (única operação em que request.resource existe; em
    // read/delete acessá-lo dá erro = negado). Impede o dono de reatribuir o
    // documento a outro uid.
    function userIdUnchanged() {
      return request.resource.data.user_id == resource.data.user_id;
    }

    function isOwnerByFieldOnCreate() {
      return isAuth() && request.auth.uid == request.resource.data.user_id;
    }

    // Allow reading a non-existing doc (resource == null) so that getDoc() on
    // log IDs that haven't been created yet returns "not found" instead of
    // "permission-denied". When the doc exists, ownership is enforced.
    function canReadLog() {
      return isAuth() && (resource == null || request.auth.uid == resource.data.user_id);
    }

    // Campos de assinatura só o servidor (Admin SDK, webhook) altera. O usuário
    // não pode se dar is_paid, estender o plano nem reiniciar o teste grátis.
    function profileSubscriptionLocked() {
      let n = request.resource.data;
      let o = resource.data;
      return n.get('is_paid', false) == o.get('is_paid', false)
        && n.get('subscription_plan', null) == o.get('subscription_plan', null)
        && n.get('subscription_expires_at', null) == o.get('subscription_expires_at', null)
        && (!('trial_started_at' in o) || n.get('trial_started_at', null) == o.get('trial_started_at', null));
    }

    function profileCreateIsFree() {
      let n = request.resource.data;
      return n.get('is_paid', false) == false
        && n.get('subscription_plan', null) == null
        && n.get('subscription_expires_at', null) == null;
    }

    match /profiles/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow create: if isAuth() && request.auth.uid == uid && profileCreateIsFree();
      allow update: if isAuth() && request.auth.uid == uid && profileSubscriptionLocked();
      // Sem delete pelo cliente: apagar e recriar o perfil reiniciaria o teste grátis.
      allow delete: if false;
    }

    match /settings/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
    }

    match /habits/{docId} {
      allow read, delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    // habit_logs use getDoc(id) on potentially non-existing docs
    match /habit_logs/{docId} {
      allow read: if canReadLog();
      allow delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    match /events/{docId} {
      allow read, delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    // event_logs use getDoc(id) on potentially non-existing docs
    match /event_logs/{docId} {
      allow read: if canReadLog();
      allow delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    match /tasks/{docId} {
      allow read, delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    match /work_items/{docId} {
      allow read, delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    // work_logs use getDoc(id) on potentially non-existing docs
    match /work_logs/{docId} {
      allow read: if canReadLog();
      allow delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    match /work_notes/{docId} {
      allow read, delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    match /goals/{docId} {
      allow read, delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    match /notifications/{docId} {
      allow read, delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    match /categories/{docId} {
      allow read, delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    match /finance_entries/{docId} {
      allow read, delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    match /finance_transactions/{docId} {
      allow read, delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    match /finance_recurring_costs/{docId} {
      allow read, delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    match /finance_potes/{docId} {
      allow read, delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    match /finance_roadmap/{docId} {
      allow read, delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    match /books/{docId} {
      allow read, delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    match /study_entries/{docId} {
      allow read, delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    // retirement_tracking uses getDoc by known ID ({uid}_{yyyyMM}) — doc may not exist yet
    match /retirement_tracking/{docId} {
      allow read: if canReadLog();
      allow delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    match /reserves/{docId} {
      allow read, delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }

    match /reserve_transactions/{docId} {
      allow read, delete: if isOwnerByField();
      allow update: if isOwnerByField() && userIdUnchanged();
      allow create: if isOwnerByFieldOnCreate();
    }
  }
}
